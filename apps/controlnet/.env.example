# .env
MODEL=model-name
CONTROLNET_MODEL=controlnet-model-name
CONTROLNET_TWO_MODEL=controlnet-second-model-name
NUM_INFERENCE_STEPS=num-inference-steps
RESULTS_DIR=./results-dir

# .env.local
DEVICE=cpu
LOG_LEVEL=DEBUG
DEBUG=True

# .env.production
DEVICE=cuda
LOG_LEVEL=INFO
DEBUG=False

AWS_ACCESS_KEY_ID=aws-access-key-id
AWS_SECRET_ACCESS_KEY=aws-secret-access-key
AWS_REGION=aws-region
AWS_S3_BUCKET=aws-s3-bucket
AWS_ECR_REPOSITORY_NAME=aws-ecr-repository-name

SAGEMAKER_INSTANCE_TYPE=sagemaker-instance-type
SAGEMAKER_ROLE_ARN=sagemaker-role-arn
SAGEMAKER_ENDPOINT_NAME=sagemaker-endpoint-name
SAGEMAKER_MODEL_NAME=sagemaker-model-name
SAGEMAKER_MEMORY_SIZE_MB=4096
SAGEMAKER_MAX_CONCURRENCY=2
RESULTS_DIR=./results-dir

ENABLE_VAE_SLICING=True
ENABLE_VAE_TILING=True
ENABLE_WARMUP=True
ENABLE_ATTENTION_SLICING=False
ENABLE_TORCH_COMPILE=False

# WeChat QR decoder models for scan verification (plan 008). The Dockerfile
# bakes them into /opt/program/wechat_models; override for local runs/tests
# (e.g. apps/controlnet/tests/.cache/wechat_models). If the files are missing
# the container still runs — verification degrades to zxing-only.
WECHAT_MODEL_DIR=/opt/program/wechat_models

# v2 repair ladder (plan 008 Phase 4): wall-clock budget in seconds, per
# image, for the repair rungs (module blend -> latent SRPG -> re-roll) that
# run when a v2 result fails scan verification.
SCAN_REPAIR_BUDGET_S=90
# Optional SR-MPGD latent polish iterations at the end of the SRPG repair
# rung (0 = off; ~10-30 lifts SSR further at extra GPU seconds/image).
V2_SRMPGD_ITERATIONS=0

# v2 hires stage (plan 008 Phase 5): final img2img x1.5 upscale
# (768 -> 1152) of the verified image, both ControlNets at 0.8x the preset
# scales. If the upscale breaks scanning the verified 768 image is returned
# instead (per-image metadata flag `hires_dropped: true`).
V2_HIRES=True

# Prompt enhancement (plan 009): an LLM (Qwen2.5-1.5B-Instruct) co-resident
# on the GPU transparently rewrites prompts for better QR blending.
# PROMPT_ENHANCEMENT_ENABLED is the ops kill-switch (False -> original prompt
# verbatim regardless of the request flag, LLM never loaded). Weights sync
# from MODEL_S3_BUCKET under PROMPT_ENHANCER_S3_PREFIX when
# ENABLE_S3_MODEL_LOADING=True (upload once with `make upload-llm-model`).
PROMPT_ENHANCEMENT_ENABLED=True
PROMPT_ENHANCER_S3_PREFIX=llm-models
# Hard cap on LLM latency per request; timeout -> rules-based fallback.
PROMPT_ENHANCER_TIMEOUT_S=4.0

ADMIN_API_TOKEN=xxxxxxxx

ENABLE_S3_MODEL_LOADING=True
PROMPT_ENHANCEMENT_ENABLED=True