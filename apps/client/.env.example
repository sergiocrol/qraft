# Baked into the static bundle at build time (Astro exposes PUBLIC_*-prefixed
# vars to the browser).
#
#   http://localhost:3001  — local development against `pnpm dev` in apps/api.
#   <empty>                — the deployed setup: API calls stay relative and
#                            are proxied by the rule in public/_redirects, so
#                            the backend host never reaches the browser.
#   https://…              — an absolute URL calls that host directly and
#                            bypasses the proxy. Fine for a one-off test,
#                            wrong for a production build.
PUBLIC_API_URL=http://localhost:3001

# Target bucket for `deploy-to-s3.sh` (the S3/CloudFront hosting path).
# Not needed for the Netlify hosting path.
BUCKET_NAME=your-s3-bucket-name
