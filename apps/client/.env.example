# Baked into the static bundle at build time (Astro exposes PUBLIC_*-prefixed
# vars to the browser). Point it at your deployed API Gateway URL for prod
# builds, or http://localhost:3001 for local development.
PUBLIC_API_URL=http://localhost:3001

# Target bucket for `deploy-to-s3.sh` (the S3/CloudFront hosting path).
# Not needed for the Netlify hosting path.
BUCKET_NAME=your-s3-bucket-name
