{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "dev:production": "NODE_ENV=production tsx watch src/server.ts",
    "build": "tsc --build",
    "build:lambda": "echo 'Lambda build handled by serverless'",
    "check-types": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "lambda:deploy": "serverless deploy --stage prod",
    "lambda:deploy:dev": "serverless deploy --stage dev",
    "lambda:remove": "serverless remove --stage prod",
    "lambda:logs": "serverless logs -f api --stage prod --tail",
    "lambda:offline": "serverless offline --stage local",
    "lambda:invoke": "serverless invoke local -f api",
    "env:setup": "node scripts/setup-env.js",
    "env:validate": "tsx src/utils/environment.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .serverless"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-dynamodb": "^3.985.0",
    "@aws-sdk/client-s3": "^3.856.0",
    "@aws-sdk/client-ses": "^3.864.0",
    "@aws-sdk/credential-providers": "^3.828.0",
    "@aws-sdk/lib-dynamodb": "^3.985.0",
    "@aws-sdk/signature-v4": "^3.374.0",
    "@repo/qr-constants": "workspace:*",
    "@repo/shared-types": "workspace:*",
    "@repo/validation-schemas": "workspace:*",
    "@types/aws-lambda": "^8.10.150",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^6.4.17",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^7.0.5",
    "serverless-http": "^3.2.0",
    "uuid": "^10.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/aws-sdk": "^2.7.4",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.14.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.24.0",
    "serverless": "^4.17.1",
    "serverless-offline": "^14.4.0",
    "tsx": "^4.19.1",
    "typescript": "^5.8.2",
    "vitest": "^2.1.0"
  }
}
