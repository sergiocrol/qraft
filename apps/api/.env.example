NODE_ENV=development
LOG_LEVEL=info

PORT=3001
HOST=0.0.0.0
# Comma-separated allowlist. For prod include your deployed frontend origin(s),
# e.g. https://your-site.netlify.app (also add that origin to the S3 bucket CORS).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

CONTROLNET_ENDPOINT=http://localhost:8080
SAGEMAKER_ENDPOINT_NAME=your-sagemaker-endpoint-name
SAGEMAKER_STAGING_ENDPOINT_NAME=your-sagemaker-staging-endpoint-name

S3_BUCKET_NAME=your-assets-bucket
S3_PUBLIC_DOMAIN=https://your-assets-bucket.s3.eu-west-1.amazonaws.com

# S3 bucket the Serverless Framework uses for deployment artifacts.
SLS_DEPLOYMENT_BUCKET=your-serverless-deployment-bucket

# Async invocation records (relay Lambda inputs / SageMaker .out results),
# joined by GET /api/gallery/examples. Set to match your relay's S3 prefixes.
# S3_ASYNC_INPUT_PREFIX=your-async-input-prefix
# S3_ASYNC_OUTPUT_PREFIX=your-async-output-prefix

REQUEST_TIMEOUT=30000
CONTROLNET_TIMEOUT=300000
HEALTH_CHECK_TIMEOUT=5000

JOB_CLEANUP_INTERVAL_MS=3600000
MAX_JOB_AGE_MS=1800000
COMPLETED_JOB_RETENTION_MS=1800000
FAILED_JOB_RETENTION_MS=3600000

ADMIN_EMAIL=email@email.com
EMAIL_FROM=email@email.com
CLIENT_URL=http://localhost:4321

ADMIN_SECRET=xxxxxxxxxxxxxxx
JWT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxx
