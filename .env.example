# Root .env — variables read by the root Makefile (and docker-compose).
# `make setup` seeds a minimal .env with AWS_REGION only; copy this file to
# .env and fill in the rest as needed.

# AWS region used by all Makefile aws/ECR/SageMaker commands
AWS_REGION=eu-west-1

# S3 bucket holding the SD base models and test QR fixtures
# (make upload-sd-models, make test-local, make test-api-server)
MODEL_S3_BUCKET=your-models-bucket

# S3 prefix for the SD base models (default: sd-models)
# MODEL_S3_PREFIX=sd-models

# Name of the hand-deployed API-Gateway relay Lambda that fronts the
# SageMaker async endpoints (source: apps/controlnet/app/lambda.py).
# Used by `make deploy-relay-lambda` — no other target redeploys it, so
# changes to lambda.py (e.g. new payload whitelist fields) do nothing in
# staging/prod until that target runs.
RELAY_LAMBDA_NAME=your-relay-lambda-function-name
